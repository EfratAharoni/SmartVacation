PORT=5000
MONGODB_URI=mongodb://localhost:27017/smartvacation
JWT_SECRET=your-super-secret-jwt-key-here
GROQ_API_KEY=your_groq_api_key_here
# Used to build password-reset links
CLIENT_URL=http://localhost:5173

# Optional SMTP (without it, emails are printed to the server console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Smart Vacation <no-reply@example.com>"

# Optional: store admin image uploads on Cloudinary (recommended in production)
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
